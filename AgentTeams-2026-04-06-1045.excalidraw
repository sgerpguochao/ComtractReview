      "updated": 1775472015366,
      "link": null,
      "locked": false,
      "text": "修改成如下配置：\n\n{\n  \"version\": 3,\n  \"lines\": [\n    [\n      { \"id\": \"1\", \"type\": \"model\", \"color\": \"hex:61AFEF\", \"bold\": true\n},\n      { \"id\": \"2\", \"type\": \"separator\" },\n      { \"id\": \"3\", \"type\": \"context-percentage\", \"color\":\n\"hex:98C379\", \"metadata\": { \"inverse\": \"true\" } },\n      { \"id\": \"4\", \"type\": \"separator\" },\n      { \"id\": \"5\", \"type\": \"session-cost\", \"color\": \"hex:E5C07B\" },\n      { \"id\": \"6\", \"type\": \"separator\" },\n      { \"id\": \"7\", \"type\": \"session-clock\", \"color\": \"hex:C678DD\" },\n      { \"id\": \"8\", \"type\": \"separator\" },\n      { \"id\": \"9\", \"type\": \"block-timer\", \"color\": \"hex:E06C75\" },\n      { \"id\": \"17\", \"type\": \"separator\" },\n      { \"id\": \"18\", \"type\": \"claude-session-id\", \"color\":\n\"hex:56B6C2\" }\n    ],\n    [\n      { \"id\": \"10\", \"type\": \"git-branch\", \"color\": \"hex:C678DD\" },\n      { \"id\": \"11\", \"type\": \"separator\" },\n      { \"id\": \"12\", \"type\": \"git-changes\", \"color\": \"hex:E5C07B\" },\n      { \"id\": \"13\", \"type\": \"separator\" },\n      { \"id\": \"14\", \"type\": \"current-working-dir\", \"color\":\n\"hex:61AFEF\" },\n      { \"id\": \"15\", \"type\": \"flex-separator\" },\n      { \"id\": \"16\", \"type\": \"tokens-total\", \"color\": \"hex:ABB2BF\" }\n    ],\n    []\n  ],\n  \"flexMode\": \"full-minus-40\",\n  \"compactThreshold\": 60,\n  \"colorLevel\": 2,\n  \"defaultSeparator\": \" │ \",\n  \"defaultPadding\": \" \",\n  \"inheritSeparatorColors\": false,\n  \"overrideBackgroundColor\": \"\",\n  \"overrideForegroundColor\": \"\",\n  \"globalBold\": false,\n  \"powerline\": {\n    \"enabled\": true,\n    \"separators\": [\"\", \"\"],\n    \"separatorInvertBackground\": [false, false],\n    \"startCaps\": [],\n    \"endCaps\": [],\n    \"theme\": \"one-dark\",\n    \"autoAlign\": true\n  }\n}\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "KMbpP6f64zlKV4TNMYJzK",
      "originalText": "修改成如下配置：\n\n{\n  \"version\": 3,\n  \"lines\": [\n    [\n      { \"id\": \"1\", \"type\": \"model\", \"color\": \"hex:61AFEF\", \"bold\": true },\n      { \"id\": \"2\", \"type\": \"separator\" },\n      { \"id\": \"3\", \"type\": \"context-percentage\", \"color\": \"hex:98C379\", \"metadata\": { \"inverse\": \"true\" } },\n      { \"id\": \"4\", \"type\": \"separator\" },\n      { \"id\": \"5\", \"type\": \"session-cost\", \"color\": \"hex:E5C07B\" },\n      { \"id\": \"6\", \"type\": \"separator\" },\n      { \"id\": \"7\", \"type\": \"session-clock\", \"color\": \"hex:C678DD\" },\n      { \"id\": \"8\", \"type\": \"separator\" },\n      { \"id\": \"9\", \"type\": \"block-timer\", \"color\": \"hex:E06C75\" },\n      { \"id\": \"17\", \"type\": \"separator\" },\n      { \"id\": \"18\", \"type\": \"claude-session-id\", \"color\": \"hex:56B6C2\" }\n    ],\n    [\n      { \"id\": \"10\", \"type\": \"git-branch\", \"color\": \"hex:C678DD\" },\n      { \"id\": \"11\", \"type\": \"separator\" },\n      { \"id\": \"12\", \"type\": \"git-changes\", \"color\": \"hex:E5C07B\" },\n      { \"id\": \"13\", \"type\": \"separator\" },\n      { \"id\": \"14\", \"type\": \"current-working-dir\", \"color\": \"hex:61AFEF\" },\n      { \"id\": \"15\", \"type\": \"flex-separator\" },\n      { \"id\": \"16\", \"type\": \"tokens-total\", \"color\": \"hex:ABB2BF\" }\n    ],\n    []\n  ],\n  \"flexMode\": \"full-minus-40\",\n  \"compactThreshold\": 60,\n  \"colorLevel\": 2,\n  \"defaultSeparator\": \" │ \",\n  \"defaultPadding\": \" \",\n  \"inheritSeparatorColors\": false,\n  \"overrideBackgroundColor\": \"\",\n  \"overrideForegroundColor\": \"\",\n  \"globalBold\": false,\n  \"powerline\": {\n    \"enabled\": true,\n    \"separators\": [\"\", \"\"],\n    \"separatorInvertBackground\": [false, false],\n    \"startCaps\": [],\n    \"endCaps\": [],\n    \"theme\": \"one-dark\",\n    \"autoAlign\": true\n  }\n}\n",
