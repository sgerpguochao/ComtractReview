    {
      "id": "HFlu2apaBN2RkmmVTJqJG",
      "type": "text",
      "x": 2227.3766310145065,
      "y": 13218.825924154105,
      "width": 642.77978515625,
      "height": 925,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
