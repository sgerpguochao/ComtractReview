    {
      "id": "S6FEP4PBZSPxJPQr7SH8w",
      "type": "text",
      "x": 1742.422064073438,
      "y": 7676.310138046254,
      "width": 648,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
