    {
      "id": "KJaYEwBg8OJcZbt5ovPTm",
      "type": "text",
      "x": 814.1479200298897,
      "y": 16958.82737904194,
      "width": 316.79998779296875,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
