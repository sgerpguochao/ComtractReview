# ContractReview Backend Environment Configuration
# 复制此文件为 .env 并填入实际值

# LLM Configuration
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=

# LangChain Configuration
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=contract-review

# Database
DATABASE_URL=sqlite:///./contract_review.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# JWT
SECRET_KEY=change-me-to-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
